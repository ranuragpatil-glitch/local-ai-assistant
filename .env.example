# Copy this file to .env — fill what you need. Never commit .env!

# GitHub token: needed for github_search_code; also raises GitHub rate limits
# Get one at: github.com/settings/tokens (classic, no permissions needed for public search)
# GITHUB_TOKEN=

# Notes folder (default: ~/notes, created automatically on first run)
# NOTES_DIR=~/notes

# Model to use (default: qwen2.5:7b)
# Small models like llama3.2 often fail at tool calling — use qwen2.5:7b or larger
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_NUM_CTX=8192

# Better search: your own local SearXNG (falls back to DuckDuckGo if not set)
# SEARXNG_URL=http://localhost:8888

# Use a separately running server instead of the built-in tools
# DEVKIT_URL=http://127.0.0.1:8000/mcp

# Storage paths and cache toggle
# DEVKIT_HOME=~/.devkit-mcp
# DEVKIT_CACHE=1
